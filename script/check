#!/bin/sh

set -eu

cd "$(dirname "$0")/.."

swift build
swift format lint --strict --recursive Sources Tests
swift test
swift run routebar validate --config examples/routebar.yaml
sh -n script/install-daemon
sh -n script/uninstall-daemon
sh -n script/install-app
sh -n script/build-app
sh -n script/build-app-icon
sh -n script/changelog-release-notes
sh -n script/package-release
sh -n script/check-release-tools
sh -n script/uninstall-app
sh -n script/prepare-release-changelog
bash -n .bumpster/hooks/pre-bump
script/check-release-tools
plutil -lint Support/io.github.phoenixweiss.routebar.plist >/dev/null
plutil -lint Support/RouteBarApp-Info.plist >/dev/null
plutil -lint Support/io.github.phoenixweiss.routebar.menu.plist >/dev/null
test -s Support/RouteBar.icns
test -s Support/Fonts/Manrope-Variable.ttf
test -s Support/Fonts/OFL.txt
test -s Support/Fonts/SOURCE.md
test "$(plutil -extract CFBundleIconFile raw -o - Support/RouteBarApp-Info.plist)" = \
  "RouteBar.icns"
test "$(plutil -extract ATSApplicationFontsPath raw -o - Support/RouteBarApp-Info.plist)" = \
  "Fonts"
grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' VERSION
grep -Fqx '## [Unreleased]' CHANGELOG.md
git diff --check
