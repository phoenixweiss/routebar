#!/bin/sh

set -eu

project_dir=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd -P)
if [ "$#" -ne 1 ]; then
  echo "Usage: script/build-app OUTPUT_APP" >&2
  exit 64
fi

output_app=$1
case "$output_app" in
  /*) ;;
  *) output_app="$PWD/$output_app" ;;
esac

if [ -e "$output_app" ]; then
  echo "Refusing to replace an existing application: $output_app" >&2
  exit 1
fi

version=$(tr -d '\n' < "$project_dir/VERSION")
if ! printf '%s\n' "$version" | grep -Eq \
  '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
  echo "VERSION must contain a SemVer version without a v prefix." >&2
  exit 1
fi

swift build --package-path "$project_dir" -c release --product routebar-app

temporary_dir=$(mktemp -d "${TMPDIR:-/tmp}/routebar-app-build.XXXXXX")
temporary_app="$temporary_dir/RouteBar.app"
cleanup_temporary_files() {
  rm -rf "$temporary_dir" 2>/dev/null || true
}
trap cleanup_temporary_files EXIT
trap 'exit 1' HUP INT TERM

mkdir -p "$temporary_app/Contents/MacOS" "$temporary_app/Contents/Resources/Fonts"
cp "$project_dir/Support/RouteBarApp-Info.plist" "$temporary_app/Contents/Info.plist"
plutil -replace CFBundleShortVersionString -string "$version" \
  "$temporary_app/Contents/Info.plist"
plutil -replace CFBundleVersion -string "$version" \
  "$temporary_app/Contents/Info.plist"
install -m 0755 "$project_dir/.build/release/routebar-app" \
  "$temporary_app/Contents/MacOS/routebar-app"
install -m 0644 "$project_dir/Support/RouteBar.icns" \
  "$temporary_app/Contents/Resources/RouteBar.icns"
install -m 0644 "$project_dir/Support/Fonts/Manrope-Variable.ttf" \
  "$temporary_app/Contents/Resources/Fonts/Manrope-Variable.ttf"
install -m 0644 "$project_dir/Support/Fonts/OFL.txt" \
  "$temporary_app/Contents/Resources/Fonts/OFL.txt"
install -m 0644 "$project_dir/Support/Fonts/SOURCE.md" \
  "$temporary_app/Contents/Resources/Fonts/SOURCE.md"
install -m 0644 "$project_dir/LICENSE" \
  "$temporary_app/Contents/Resources/LICENSE"

plutil -lint "$temporary_app/Contents/Info.plist" >/dev/null
codesign --force --deep --sign - "$temporary_app" >/dev/null
codesign --verify --deep --strict --verbose=4 "$temporary_app"

mkdir -p "$(dirname "$output_app")"
mv "$temporary_app" "$output_app"

echo "Built RouteBar $version: $output_app"
