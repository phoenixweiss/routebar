#!/bin/sh

set -eu

project_dir=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd -P)
if [ "$#" -gt 2 ] || [ "$#" -lt 1 ]; then
  echo "Usage: script/verify-app-bundle APP_PATH [ARCHITECTURE]" >&2
  exit 64
fi

app_path=$1
architecture=${2:-$(uname -m)}
case "$app_path" in
  /*) ;;
  *) app_path="$PWD/$app_path" ;;
esac
case "$architecture" in
  arm64|x86_64) ;;
  *)
    echo "Unsupported application architecture: $architecture" >&2
    exit 1
    ;;
esac

version=$(tr -d '\n' < "$project_dir/VERSION")
info_plist="$app_path/Contents/Info.plist"
main_executable="$app_path/Contents/MacOS/routebar-app"
daemon_executable="$app_path/Contents/Resources/routebar-daemon"
daemon_plist="$app_path/Contents/Library/LaunchDaemons/io.github.phoenixweiss.routebar.plist"

test -d "$app_path"
test -f "$info_plist"
test -x "$main_executable"
test -x "$daemon_executable"
test -f "$daemon_plist"

plutil -lint "$info_plist" "$daemon_plist" >/dev/null
test "$(plutil -extract CFBundleShortVersionString raw -o - "$info_plist")" = "$version"
test "$(plutil -extract CFBundleVersion raw -o - "$info_plist")" = "$version"
test "$(plutil -extract CFBundleIdentifier raw -o - "$info_plist")" = \
  "io.github.phoenixweiss.routebar.menu"

test "$(plutil -extract Label raw -o - "$daemon_plist")" = \
  "io.github.phoenixweiss.routebar"
test "$(plutil -extract BundleProgram raw -o - "$daemon_plist")" = \
  "Contents/Resources/routebar-daemon"
test "$(plutil -extract AssociatedBundleIdentifiers raw -o - "$daemon_plist")" = \
  "io.github.phoenixweiss.routebar.menu"
test "$(plutil -extract EnvironmentVariables.ROUTEBAR_HELPER_VERSION raw -o - \
  "$daemon_plist")" = "$version"
test "$(/usr/libexec/PlistBuddy -c \
  'Print :MachServices:io.github.phoenixweiss.routebar' "$daemon_plist")" = \
  "true"
test "$(plutil -extract UserName raw -o - "$daemon_plist")" = "root"
if plutil -extract Program raw -o - "$daemon_plist" >/dev/null 2>&1; then
  echo "Bundled daemon plist must not contain Program." >&2
  exit 1
fi
if plutil -extract ProgramArguments raw -o - "$daemon_plist" >/dev/null 2>&1; then
  echo "Bundled daemon plist must not contain ProgramArguments." >&2
  exit 1
fi

file "$main_executable" | grep -q "$architecture"
file "$daemon_executable" | grep -q "$architecture"
codesign --verify --strict --verbose=4 "$daemon_executable"
codesign --verify --deep --strict --verbose=4 "$app_path"
codesign -d -r- "$app_path" 2>&1 | grep -q 'designated => '

echo "Verified RouteBar $version app bundle for $architecture: $app_path"
