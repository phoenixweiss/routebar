#!/bin/sh

set -eu

project_dir=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd -P)
binary_source="$project_dir/.build/debug/routebar"
plugin_source="$project_dir/SwiftBar/routebar.1m.sh"
binary_target="$HOME/.local/bin/routebar"
plugin_dir=$(defaults read com.ameba.SwiftBar PluginDirectory 2>/dev/null || true)

if [ -z "$plugin_dir" ]; then
  echo "SwiftBar plugin directory is not configured." >&2
  exit 1
fi

swift build --package-path "$project_dir"
mkdir -p "$HOME/.local/bin"

link_if_available() {
  source_path=$1
  target_path=$2

  if [ -L "$target_path" ] && [ "$(readlink "$target_path")" = "$source_path" ]; then
    return
  fi
  if [ -e "$target_path" ] || [ -L "$target_path" ]; then
    echo "Refusing to replace existing path: $target_path" >&2
    exit 1
  fi
  ln -s "$source_path" "$target_path"
}

link_if_available "$binary_source" "$binary_target"
link_if_available "$plugin_source" "$plugin_dir/routebar.1m.sh"

open "swiftbar://refreshallplugins"
echo "RouteBar development plugin installed."
echo "Binary: $binary_target"
echo "Plugin: $plugin_dir/routebar.1m.sh"
