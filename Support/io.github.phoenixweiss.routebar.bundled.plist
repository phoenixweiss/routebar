<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>AssociatedBundleIdentifiers</key>
  <string>io.github.phoenixweiss.routebar.menu</string>
  <key>BundleProgram</key>
  <string>Contents/Resources/routebar-daemon</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ROUTEBAR_HELPER_VERSION</key>
    <string>__VERSION__</string>
  </dict>
  <key>Label</key>
  <string>io.github.phoenixweiss.routebar</string>
  <key>MachServices</key>
  <dict>
    <key>io.github.phoenixweiss.routebar</key>
    <true/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>RunAtLoad</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>UserName</key>
  <string>root</string>
</dict>
</plist>
