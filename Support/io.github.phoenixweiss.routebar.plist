<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.phoenixweiss.routebar</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/PrivilegedHelperTools/io.github.phoenixweiss.routebar</string>
    <string>reconcile</string>
    <string>--apply</string>
    <string>--quiet</string>
    <string>--config</string>
    <string>__CONFIG_PATH__</string>
    <string>--profile</string>
    <string>__PROFILE_ID__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
